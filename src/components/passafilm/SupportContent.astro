---
import { contactEmail, support, type Locale } from "../../data/passafilm";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = support[locale];
const titleId = `support-${locale}`;
---

<article id={locale} lang={locale} aria-labelledby={titleId}>
  <h2 id={titleId} class="text-3xl font-semibold tracking-tight md:text-4xl">{copy.title}</h2>
  <p class="mt-4 text-lg leading-relaxed text-muted">{copy.intro}</p>
  <p class="mt-6 leading-relaxed text-muted">
    {copy.contact} <a href={`mailto:${contactEmail}`} class="link-underline text-ink">{contactEmail}</a>.
  </p>
  <h3 class="mt-10 text-xl font-semibold tracking-tight">{copy.deleteTitle}</h3>
  <p class="mt-3 leading-relaxed text-muted">{copy.deleteBody}</p>
  <a href={`/passafilm/privacy#${locale}`} class="btn btn-ghost mt-8">{copy.privacy}</a>
</article>

---
import { contactEmail, lastUpdated, privacy, processors, type Locale } from "../../data/passafilm";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = privacy[locale];
const titleId = `privacy-${locale}`;
---

<article id={locale} lang={locale} aria-labelledby={titleId}>
  <h2 id={titleId} class="text-3xl font-semibold tracking-tight text-balance md:text-4xl">{copy.title}</h2>
  <section class="mt-8 rounded-3xl bg-surface p-6 md:p-8">
    <h3 class="text-lg font-semibold">{copy.summaryTitle}</h3>
    <ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed text-muted marker:text-ink">
      {copy.summary.map((line) => <li>{line}</li>)}
    </ul>
  </section>
  <div class="mt-12 space-y-10">
    {
      copy.sections.map((section) => (
        <section>
          <h3 class="text-xl font-semibold tracking-tight">{section.title}</h3>
          {section.items && (
            <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-muted marker:text-ink">
              {section.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {section.paragraphs?.map((p) => (
            <p class="mt-3 leading-relaxed text-muted">{p}</p>
          ))}
        </section>
      ))
    }
    <section>
      <h3 class="text-xl font-semibold tracking-tight">{copy.processorsTitle}</h3>
      <p class="mt-3 leading-relaxed text-muted">{copy.processorsIntro}</p>
      <dl class="mt-6 grid gap-x-10 gap-y-6 sm:grid-cols-2">
        {
          processors.map((p) => (
            <div>
              <dt class="flex items-baseline justify-between gap-4">
                <a
                  href={p.href}
                  target="_blank"
                  rel="noopener"
                  class="link-underline font-semibold"
                  aria-label={`${copy.processorsLink} ${p.name}`}
                >
                  {p.name}
                </a>
                <span class="text-[13px] text-muted">{p.location[locale]}</span>
              </dt>
              <dd class="mt-1.5 leading-relaxed text-muted">{p.purpose[locale]}</dd>
            </div>
          ))
        }
      </dl>
    </section>
    <section>
      <h3 class="text-xl font-semibold tracking-tight">{copy.contactTitle}</h3>
      <p class="mt-3 leading-relaxed text-muted">
        {copy.contactBody} <a href={`mailto:${contactEmail}`} class="link-underline text-ink">{contactEmail}</a>.
      </p>
    </section>
  </div>
  <p class="mt-12 text-[14px] text-muted">{copy.updated}: {lastUpdated[locale]}</p>
</article>

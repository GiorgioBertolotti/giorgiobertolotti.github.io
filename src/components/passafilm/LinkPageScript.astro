---
// Behaviour shared by the PassaFilm link landing pages. Inline and synchronous, like the page scripts that use it, so
// the page never flashes the wrong language or the wrong store.
---

<script is:inline>
  window.passafilmLink = (() => {
    // iPadOS reports itself as a Mac, so tell it apart by touch support
    const isAndroid = /android/i.test(navigator.userAgent);
    const isIOS =
      /iPhone|iPad|iPod/i.test(navigator.userAgent) ||
      (/Macintosh/i.test(navigator.userAgent) && navigator.maxTouchPoints > 1);
    const isMobile = isAndroid || isIOS;

    function translate(strings) {
      const locale = (navigator.language || "it").toLowerCase().startsWith("it") ? "it" : "en";
      const t = strings[locale];
      document.documentElement.lang = locale;
      document.querySelectorAll("[data-i18n]").forEach((el) => {
        el.textContent = t[el.dataset.i18n];
      });
      return { locale, t };
    }

    // Same alphabet and length as the codes generated by the database: no 0/O or 1/I. Null when malformed.
    function readCode() {
      const code = (new URLSearchParams(location.search).get("code") || "").trim().toUpperCase();
      return /^[A-HJ-NP-Z2-9]{6}$/.test(code) ? code : null;
    }

    // Leads with the store for this device; on desktop there's no app to open, so the text points at the phone
    function showStores(desktopBody) {
      if (isIOS) document.getElementById("play-store").hidden = true;
      if (isAndroid) document.getElementById("app-store").hidden = true;
      if (!isMobile) document.getElementById("stores-body").textContent = desktopBody;
    }

    // Chrome on Android only follows custom schemes through an intent, which also falls back to the Play Store
    function openInAppHref(appPath, playStoreUrl) {
      return isAndroid
        ? "intent://" +
            appPath +
            "#Intent;scheme=passafilm;package=com.passafilm.app;S.browser_fallback_url=" +
            encodeURIComponent(playStoreUrl) +
            ";end"
        : "passafilm://" + appPath;
    }

    // iOS has no intent fallback: without the app Safari just shows an "invalid address" alert. If the page is still
    // in front shortly after, point at the App Store instead of redirecting, since with the app installed Safari first
    // asks "Open in PassaFilm?" and the page stays visible while the visitor reads that prompt.
    function pointAtAppStoreIfNothingOpens(openLink) {
      if (!isIOS) return;
      let fallbackTimer;
      const cancelFallback = () => clearTimeout(fallbackTimer);
      document.addEventListener("visibilitychange", () => document.hidden && cancelFallback());
      window.addEventListener("pagehide", cancelFallback);

      openLink.addEventListener("click", () => {
        cancelFallback();
        fallbackTimer = setTimeout(() => {
          if (document.visibilityState !== "visible") return;
          document.getElementById("not-installed").hidden = false;
          document.getElementById("app-store").classList.replace("button--tonal", "button--primary");
          const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
          document.getElementById("stores").scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth" });
        }, 2000);
      });
    }

    return { isMobile, translate, readCode, showStores, openInAppHref, pointAtAppStoreIfNothingOpens };
  })();
</script>

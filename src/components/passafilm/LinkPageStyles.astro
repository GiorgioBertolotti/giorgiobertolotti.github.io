---
// Shared look of the PassaFilm link landing pages (group invites and personal links)
---

<style is:global>
  @font-face {
    font-family: "Outfit";
    src: url("/passafilm/Outfit-VF.woff2") format("woff2");
    font-weight: 400 700;
    font-display: swap;
  }

  :root {
    --ink: #0b0b14;
    --surface: #15151f;
    --card: #1f1f2e;
    --line: #2f2f42;
    --red: #f0443a;
    --red-pressed: #d93a31;
    --screen: #f2f2f7;
    --muted: #a3a3b5;
    --notch: 15px;
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    background: var(--ink);
    color: var(--screen);
    font-family: "Outfit", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 17px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  main {
    width: 100%;
    max-width: 26rem;
    margin: 0 auto;
    padding: max(2.5rem, env(safe-area-inset-top)) 1.25rem max(2.5rem, env(safe-area-inset-bottom));
  }

  .logo {
    display: block;
    width: 9.5rem;
    height: auto;
  }

  h1 {
    margin: 2.75rem 0 0;
    font-size: 2.5rem;
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .lede {
    margin: 0.875rem 0 0;
    color: var(--muted);
    max-width: 30ch;
  }

  .ticket {
    position: relative;
    margin-top: 2.25rem;
    border-radius: 1.5rem;
    background: var(--card);
  }

  .ticket__stub {
    padding: 1.5rem 1.5rem 1.75rem;
  }

  .ticket__label {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .ticket__code {
    display: block;
    margin-top: 0.25rem;
    font-size: clamp(2.75rem, 14vw, 3.5rem);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    user-select: all;
    -webkit-user-select: all;
  }

  /* The perforation: a dashed tear line between two notches cut in the ink background */
  .ticket__tear {
    position: relative;
    height: calc(var(--notch) * 2);
    margin: 0 calc(var(--notch) * -1);
  }

  .ticket__tear::before {
    content: "";
    position: absolute;
    left: calc(var(--notch) * 2 + 0.5rem);
    right: calc(var(--notch) * 2 + 0.5rem);
    top: 50%;
    border-top: 2px dashed var(--line);
  }

  .ticket__tear::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at var(--notch) 50%, var(--ink) var(--notch), transparent calc(var(--notch) + 0.5px)),
      radial-gradient(circle at calc(100% - var(--notch)) 50%, var(--ink) var(--notch), transparent calc(var(--notch) + 0.5px));
  }

  .ticket__actions {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
  }

  .button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 3.25rem;
    padding: 0 1.5rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      transform 120ms ease-out,
      background-color 120ms ease-out;
    -webkit-tap-highlight-color: transparent;
  }

  .button:active {
    transform: scale(0.98);
  }

  .button:focus-visible {
    outline: 3px solid var(--screen);
    outline-offset: 3px;
  }

  /* 19px bold counts as large text for WCAG: white on the brand red (3.6:1) needs that to pass AA */
  .ticket__actions .button {
    font-size: 1.1875rem;
    font-weight: 700;
  }

  .ticket__actions .button svg {
    width: 1.3125rem;
    height: 1.3125rem;
  }

  .button--primary {
    background: var(--red);
    color: #fff;
  }

  .button--primary:active {
    background: var(--red-pressed);
  }

  .button--tonal {
    background: var(--surface);
    color: var(--screen);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .button svg {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
  }

  .stores {
    margin-top: 2.75rem;
  }

  .stores h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .stores p {
    margin: 0.375rem 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .stores__links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .stores__links .button {
    height: 2.75rem;
    padding: 0 1rem;
    font-size: 0.9375rem;
  }

  /* Only one store is shown on a phone: give it the full row */
  .stores__links:has(> [hidden]) {
    grid-template-columns: 1fr;
  }

  .stores .notice {
    margin: 0 0 1.25rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--red);
    color: var(--screen);
    font-size: 0.9375rem;
  }

  .invalid {
    margin-top: 2.25rem;
    padding: 1.5rem;
    border-radius: 1.5rem;
    background: var(--card);
    color: var(--muted);
  }

  .invalid strong {
    display: block;
    color: var(--screen);
    font-size: 1.125rem;
    font-weight: 600;
  }

  [hidden] {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
    .button:active {
      transform: none;
    }
  }
</style>

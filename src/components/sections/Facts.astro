---
import { facts } from "../../data/site";
---

<section aria-label="At a glance" class="container-page">
  <dl class="grid grid-cols-1 gap-x-10 gap-y-10 border-t border-line pt-12 sm:grid-cols-2 lg:grid-cols-4">
    {
      facts.map((fact, i) => (
        <div data-reveal style={`--i:${i}`} class="flex flex-col-reverse">
          <dt class="mt-3 max-w-[28ch] text-[15px] leading-relaxed text-muted">{fact.label}</dt>
          <dd class="text-4xl font-semibold tracking-tight md:text-[2.75rem]">{fact.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

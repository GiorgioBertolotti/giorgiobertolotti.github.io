---
import { experience } from "../../data/site";
---

<section id="experience" class="bg-surface">
  <div class="container-page py-28 md:py-40">
    <div class="max-w-2xl" data-reveal>
      <h2 class="section-title">Teams I've worked with</h2>
      <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-muted">
        Startups, SaaS companies and software houses, as a freelancer, an employee and a co-founder.
      </p>
    </div>

    <!-- 2-column grouped list, no row dividers. < md: one column. -->
    <ol class="mt-16 grid gap-x-16 gap-y-12 md:grid-cols-2">
      {
        experience.map((item, i) => (
          <li data-reveal style={`--i:${i % 2}`} class="max-w-[52ch]">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="text-xl font-semibold tracking-tight">
                {item.href ? (
                  <a href={item.href} target="_blank" rel="noopener" class="link-underline">
                    {item.company}
                  </a>
                ) : (
                  item.company
                )}
              </h3>
              <span class="text-[14px] tabular-nums text-muted">{item.period}</span>
            </div>
            <p class="mt-1 text-[15px] font-medium">{item.role}</p>
            <p class="mt-3 leading-relaxed text-muted">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

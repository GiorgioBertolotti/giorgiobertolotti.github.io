---
import { Image } from "astro:assets";
import Icon from "../Icon.astro";
import { featured, projects } from "../../data/site";
---

<section id="work" class="border-t border-line">
  <div class="container-page py-28 md:py-40">
    <h2 class="section-title max-w-2xl" data-reveal>Selected work</h2>

    <!-- Featured: image left / copy right. < md: stacked. -->
    <article class="mt-16 grid items-center gap-10 md:grid-cols-12 md:gap-16" data-reveal>
      <a
        href={featured.href}
        target="_blank"
        rel="noopener"
        class="group block overflow-hidden rounded-3xl bg-[#e3e3e3] media-frame md:col-span-7"
        aria-label={`${featured.name} website`}
      >
        <Image
          src={featured.image}
          alt={featured.imageAlt}
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 55vw, 100vw"
          class="w-full transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.02]"
        />
      </a>
      <div class="md:col-span-5">
        <p class="text-[15px] text-muted">{featured.role}</p>
        <h3 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">{featured.name}</h3>
        <p class="mt-5 leading-relaxed text-muted">{featured.body}</p>
        <p class="mt-8">
          <span class="text-4xl font-semibold tracking-tight">{featured.stat.value}</span>
          <span class="ml-2 text-muted">{featured.stat.label}</span>
        </p>
        <ul class="mt-8 flex flex-wrap gap-2" aria-label="Stack">
          {featured.stack.map((item) => <li class="chip">{item}</li>)}
        </ul>
        <a href={featured.href} target="_blank" rel="noopener" class="link-underline mt-10 inline-flex items-center gap-1.5 font-medium">
          Visit mangatime.net <Icon name="arrow-up-right" size={16} />
        </a>
      </div>
    </article>

    <!-- Other projects: 2x2 grid. < sm: one column. -->
    <div class="mt-24 grid gap-x-8 gap-y-16 sm:grid-cols-2 md:mt-32">
      {
        projects.map((project, i) => (
          <article data-reveal style={`--i:${i % 2}`}>
            <a href={project.href} target="_blank" rel="noopener" class="group block" aria-label={`${project.name}: ${project.linkLabel}`}>
              <div class="overflow-hidden rounded-3xl bg-white media-frame">
                <Image
                  src={project.image}
                  alt={project.imageAlt}
                  widths={[400, 640]}
                  sizes="(min-width: 640px) 45vw, 100vw"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.02]"
                  style={`object-position: ${project.focus ?? "center top"}`}
                />
              </div>
              <div class="mt-6 flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-xl font-semibold tracking-tight">{project.name}</h3>
                  <p class="mt-1 text-[15px] text-muted">{project.kind}</p>
                </div>
                <Icon
                  name="arrow-up-right"
                  size={20}
                  class="mt-1 shrink-0 text-muted transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-ink"
                />
              </div>
              <p class="mt-3 max-w-[48ch] leading-relaxed text-muted">{project.body}</p>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

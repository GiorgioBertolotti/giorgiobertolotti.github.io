---
import LinkPageScript from "../../components/passafilm/LinkPageScript.astro";
import LinkPageStyles from "../../components/passafilm/LinkPageStyles.astro";

// Landing for PassaFilm invite links. With the app installed, iOS universal links and Android app links open
// the app directly and this page is never shown; it covers everyone else.
const appStoreId = "6836820722";
const appStoreUrl = `https://apps.apple.com/app/id${appStoreId}`;
const playStoreUrl = "https://play.google.com/store/apps/details?id=com.passafilm.app";
const title = "Unisciti al mio gruppo su PassaFilm";
const description = "Consigliatevi film tra amici e tenete traccia di cosa guardare.";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0b0b14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/passafilm/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/passafilm/Outfit-VF.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PassaFilm" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://bertolotti.dev/passafilm/og.png" />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta name="twitter:card" content="summary" />
    <!-- Safari's Smart App Banner: "Get" without the app, "Open" with it. app-argument hands the app the invite URL,
         so it's filled in here in the head, before Safari reads the tag. The code is the only part taken from the
         URL, encoded so a crafted link can't slip extra comma-separated keys into the tag. -->
    <meta name="apple-itunes-app" id="itunes" content={`app-id=${appStoreId}`} />
    <script is:inline define:vars={{ appStoreId }}>
      const inviteCode = new URLSearchParams(location.search).get("code");
      if (inviteCode) {
        const appArgument = "https://bertolotti.dev/passafilm/join?code=" + encodeURIComponent(inviteCode.trim());
        document.getElementById("itunes").content = "app-id=" + appStoreId + ", app-argument=" + appArgument;
      }
    </script>
    <LinkPageStyles />
  </head>
  <body>
    <main>
      <img class="logo" src="/passafilm/logo.svg" alt="PassaFilm" width="732" height="156" />

      <h1 data-i18n="title">Ti hanno invitato in un gruppo</h1>
      <p class="lede" data-i18n="lede">{description}</p>

      <section class="ticket" id="ticket" aria-labelledby="code-label" hidden>
        <div class="ticket__stub">
          <p class="ticket__label" id="code-label" data-i18n="codeLabel">Codice invito</p>
          <output class="ticket__code" id="code" aria-labelledby="code-label"></output>
        </div>
        <div class="ticket__tear" aria-hidden="true"></div>
        <div class="ticket__actions">
          <a class="button button--primary" id="open" href="#" data-i18n="open">Apri in PassaFilm</a>
          <button class="button button--tonal" id="copy" type="button" aria-live="polite">
            <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path
                id="copy-icon"
                d="M216 32H88a8 8 0 0 0-8 8v40H40a8 8 0 0 0-8 8v128a8 8 0 0 0 8 8h128a8 8 0 0 0 8-8v-40h40a8 8 0 0 0 8-8V40a8 8 0 0 0-8-8Zm-56 176H48V96h112Zm48-48h-32V88a8 8 0 0 0-8-8H96V48h112Z"
              ></path>
            </svg>
            <span id="copy-label" data-i18n="copy">Copia codice</span>
          </button>
        </div>
      </section>

      <section class="invalid" id="invalid" hidden>
        <strong data-i18n="invalidTitle">Questo link di invito è incompleto</strong>
        <span data-i18n="invalidBody">Chiedi a chi ti ha invitato di mandartelo di nuovo, oppure fatti dire il codice.</span>
      </section>

      <section class="stores" id="stores" aria-labelledby="stores-title">
        <!-- The live region stays in the DOM so screen readers announce the notice when it's revealed -->
        <div role="status">
          <p class="notice" id="not-installed" hidden data-i18n="notInstalled">
            Non si è aperto niente? Probabilmente PassaFilm non è ancora installata.
          </p>
        </div>
        <h2 id="stores-title" data-i18n="storesTitle">Non hai ancora l'app?</h2>
        <p id="stores-body" data-i18n="storesBody">Installala, poi tocca di nuovo il link di invito.</p>
        <div class="stores__links">
          <a class="button button--tonal" id="app-store" href={appStoreUrl}>App Store</a>
          <a class="button button--tonal" id="play-store" href={playStoreUrl}>Google Play</a>
        </div>
      </section>
    </main>

    <LinkPageScript />
    <script is:inline define:vars={{ playStoreUrl }}>
      const strings = {
        it: {
          title: "Ti hanno invitato in un gruppo",
          lede: "Consigliatevi film tra amici e tenete traccia di cosa guardare.",
          codeLabel: "Codice invito",
          open: "Apri in PassaFilm",
          copy: "Copia codice",
          copied: "Copiato",
          invalidTitle: "Questo link di invito è incompleto",
          invalidBody: "Chiedi a chi ti ha invitato di mandartelo di nuovo, oppure fatti dire il codice.",
          storesTitle: "Non hai ancora l'app?",
          storesBody: "Installala, poi tocca di nuovo il link di invito.",
          storesBodyDesktop: "Installala sul telefono, poi apri lì il link di invito.",
          notInstalled: "Non si è aperto niente? Probabilmente PassaFilm non è ancora installata.",
        },
        en: {
          title: "You've been invited to a group",
          lede: "Recommend movies to your friends and keep track of what to watch.",
          codeLabel: "Invite code",
          open: "Open in PassaFilm",
          copy: "Copy code",
          copied: "Copied",
          invalidTitle: "This invite link is incomplete",
          invalidBody: "Ask the person who invited you to send it again, or to tell you the code.",
          storesTitle: "Don't have the app yet?",
          storesBody: "Install it, then tap the invite link again.",
          storesBodyDesktop: "Install it on your phone, then open the invite link there.",
          notInstalled: "Nothing happened? PassaFilm probably isn't installed yet.",
        },
      };

      const link = window.passafilmLink;
      const { locale, t } = link.translate(strings);
      document.title = locale === "it" ? "Unisciti al mio gruppo su PassaFilm" : "Join my group on PassaFilm";

      const code = link.readCode();
      link.showStores(t.storesBodyDesktop);
      document.getElementById(code ? "ticket" : "invalid").hidden = false;

      if (code) {
        document.getElementById("code").textContent = code;

        const openLink = document.getElementById("open");
        openLink.href = link.openInAppHref("groups/join?code=" + encodeURIComponent(code), playStoreUrl);
        openLink.hidden = !link.isMobile;
        link.pointAtAppStoreIfNothingOpens(openLink);

        const copyButton = document.getElementById("copy");
        const copyLabel = document.getElementById("copy-label");
        const copyIcon = document.getElementById("copy-icon");
        const copyPath = copyIcon.getAttribute("d");
        const checkPath =
          "M229.66 77.66l-128 128a8 8 0 0 1-11.32 0l-56-56a8 8 0 0 1 11.32-11.32L96 188.69 218.34 66.34a8 8 0 0 1 11.32 11.32Z";
        let resetTimer;

        copyButton.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(code);
          } catch {
            const range = document.createRange();
            range.selectNodeContents(document.getElementById("code"));
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
            return;
          }
          copyLabel.textContent = t.copied;
          copyIcon.setAttribute("d", checkPath);
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            copyLabel.textContent = t.copy;
            copyIcon.setAttribute("d", copyPath);
          }, 2000);
        });
      }
    </script>
  </body>
</html>

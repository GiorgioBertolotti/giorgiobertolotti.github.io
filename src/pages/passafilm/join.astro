---
// Landing for PassaFilm invite links. With the app installed, iOS universal links and Android app links open
// the app directly and this page is never shown; it covers everyone else.
const appStoreId = "6836820722";
const appStoreUrl = `https://apps.apple.com/app/id${appStoreId}`;
const playStoreUrl = "https://play.google.com/store/apps/details?id=com.passafilm.app";
const title = "Unisciti al mio gruppo su PassaFilm";
const description = "Consigliatevi film tra amici e tenete traccia di cosa guardare.";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0b0b14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/passafilm/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/passafilm/Outfit-VF.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PassaFilm" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://bertolotti.dev/passafilm/og.png" />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta name="twitter:card" content="summary" />
    <!-- Safari's Smart App Banner: "Get" without the app, "Open" with it. app-argument hands the app the invite URL,
         so it's filled in here in the head, before Safari reads the tag. The code is the only part taken from the
         URL, encoded so a crafted link can't slip extra comma-separated keys into the tag. -->
    <meta name="apple-itunes-app" id="itunes" content={`app-id=${appStoreId}`} />
    <script is:inline define:vars={{ appStoreId }}>
      const inviteCode = new URLSearchParams(location.search).get("code");
      if (inviteCode) {
        const appArgument = "https://bertolotti.dev/passafilm/join?code=" + encodeURIComponent(inviteCode.trim());
        document.getElementById("itunes").content = "app-id=" + appStoreId + ", app-argument=" + appArgument;
      }
    </script>
    <style is:global>
      @font-face {
        font-family: "Outfit";
        src: url("/passafilm/Outfit-VF.woff2") format("woff2");
        font-weight: 400 700;
        font-display: swap;
      }

      :root {
        --ink: #0b0b14;
        --surface: #15151f;
        --card: #1f1f2e;
        --line: #2f2f42;
        --red: #f0443a;
        --red-pressed: #d93a31;
        --screen: #f2f2f7;
        --muted: #a3a3b5;
        --notch: 15px;
        color-scheme: dark;
      }

      * {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        background: var(--ink);
        color: var(--screen);
        font-family: "Outfit", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        font-size: 17px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      main {
        width: 100%;
        max-width: 26rem;
        margin: 0 auto;
        padding: max(2.5rem, env(safe-area-inset-top)) 1.25rem max(2.5rem, env(safe-area-inset-bottom));
      }

      .logo {
        display: block;
        width: 9.5rem;
        height: auto;
      }

      h1 {
        margin: 2.75rem 0 0;
        font-size: 2.5rem;
        line-height: 1.08;
        font-weight: 600;
        letter-spacing: -0.025em;
        text-wrap: balance;
      }

      .lede {
        margin: 0.875rem 0 0;
        color: var(--muted);
        max-width: 30ch;
      }

      .ticket {
        position: relative;
        margin-top: 2.25rem;
        border-radius: 1.5rem;
        background: var(--card);
      }

      .ticket__stub {
        padding: 1.5rem 1.5rem 1.75rem;
      }

      .ticket__label {
        margin: 0;
        color: var(--muted);
        font-size: 0.9375rem;
      }

      .ticket__code {
        display: block;
        margin-top: 0.25rem;
        font-size: clamp(2.75rem, 14vw, 3.5rem);
        line-height: 1.1;
        font-weight: 700;
        letter-spacing: 0.14em;
        font-variant-numeric: tabular-nums;
        user-select: all;
        -webkit-user-select: all;
      }

      /* The perforation: a dashed tear line between two notches cut in the ink background */
      .ticket__tear {
        position: relative;
        height: calc(var(--notch) * 2);
        margin: 0 calc(var(--notch) * -1);
      }

      .ticket__tear::before {
        content: "";
        position: absolute;
        left: calc(var(--notch) * 2 + 0.5rem);
        right: calc(var(--notch) * 2 + 0.5rem);
        top: 50%;
        border-top: 2px dashed var(--line);
      }

      .ticket__tear::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at var(--notch) 50%, var(--ink) var(--notch), transparent calc(var(--notch) + 0.5px)),
          radial-gradient(circle at calc(100% - var(--notch)) 50%, var(--ink) var(--notch), transparent calc(var(--notch) + 0.5px));
      }

      .ticket__actions {
        display: grid;
        gap: 0.75rem;
        padding: 1.5rem;
      }

      .button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        height: 3.25rem;
        padding: 0 1.5rem;
        border: 0;
        border-radius: 999px;
        font: inherit;
        font-size: 1.0625rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        transition:
          transform 120ms ease-out,
          background-color 120ms ease-out;
        -webkit-tap-highlight-color: transparent;
      }

      .button:active {
        transform: scale(0.98);
      }

      .button:focus-visible {
        outline: 3px solid var(--screen);
        outline-offset: 3px;
      }

      /* 19px bold counts as large text for WCAG: white on the brand red (3.6:1) needs that to pass AA */
      .ticket__actions .button {
        font-size: 1.1875rem;
        font-weight: 700;
      }

      .ticket__actions .button svg {
        width: 1.3125rem;
        height: 1.3125rem;
      }

      .button--primary {
        background: var(--red);
        color: #fff;
      }

      .button--primary:active {
        background: var(--red-pressed);
      }

      .button--tonal {
        background: var(--surface);
        color: var(--screen);
        box-shadow: inset 0 0 0 1px var(--line);
      }

      .button svg {
        width: 1.125rem;
        height: 1.125rem;
        flex: none;
      }

      .stores {
        margin-top: 2.75rem;
      }

      .stores h2 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .stores p {
        margin: 0.375rem 0 0;
        color: var(--muted);
        font-size: 0.9375rem;
      }

      .stores__links {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        margin-top: 1.25rem;
      }

      .stores__links .button {
        height: 2.75rem;
        padding: 0 1rem;
        font-size: 0.9375rem;
      }

      /* Only one store is shown on a phone: give it the full row */
      .stores__links:has(> [hidden]) {
        grid-template-columns: 1fr;
      }

      .stores .notice {
        margin: 0 0 1.25rem;
        padding: 1rem 1.25rem;
        border-radius: 1rem;
        background: var(--card);
        box-shadow: inset 0 0 0 1px var(--red);
        color: var(--screen);
        font-size: 0.9375rem;
      }

      .invalid {
        margin-top: 2.25rem;
        padding: 1.5rem;
        border-radius: 1.5rem;
        background: var(--card);
        color: var(--muted);
      }

      .invalid strong {
        display: block;
        color: var(--screen);
        font-size: 1.125rem;
        font-weight: 600;
      }

      [hidden] {
        display: none !important;
      }

      @media (prefers-reduced-motion: reduce) {
        .button {
          transition: none;
        }
        .button:active {
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <img class="logo" src="/passafilm/logo.svg" alt="PassaFilm" width="732" height="156" />

      <h1 data-i18n="title">Ti hanno invitato in un gruppo</h1>
      <p class="lede" data-i18n="lede">{description}</p>

      <section class="ticket" id="ticket" aria-labelledby="code-label" hidden>
        <div class="ticket__stub">
          <p class="ticket__label" id="code-label" data-i18n="codeLabel">Codice invito</p>
          <output class="ticket__code" id="code" aria-labelledby="code-label"></output>
        </div>
        <div class="ticket__tear" aria-hidden="true"></div>
        <div class="ticket__actions">
          <a class="button button--primary" id="open" href="#" data-i18n="open">Apri in PassaFilm</a>
          <button class="button button--tonal" id="copy" type="button" aria-live="polite">
            <svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path
                id="copy-icon"
                d="M216 32H88a8 8 0 0 0-8 8v40H40a8 8 0 0 0-8 8v128a8 8 0 0 0 8 8h128a8 8 0 0 0 8-8v-40h40a8 8 0 0 0 8-8V40a8 8 0 0 0-8-8Zm-56 176H48V96h112Zm48-48h-32V88a8 8 0 0 0-8-8H96V48h112Z"
              ></path>
            </svg>
            <span id="copy-label" data-i18n="copy">Copia codice</span>
          </button>
        </div>
      </section>

      <section class="invalid" id="invalid" hidden>
        <strong data-i18n="invalidTitle">Questo link di invito è incompleto</strong>
        <span data-i18n="invalidBody">Chiedi a chi ti ha invitato di mandartelo di nuovo, oppure fatti dire il codice.</span>
      </section>

      <section class="stores" id="stores" aria-labelledby="stores-title">
        <!-- The live region stays in the DOM so screen readers announce the notice when it's revealed -->
        <div role="status">
          <p class="notice" id="not-installed" hidden data-i18n="notInstalled">
            Non si è aperto niente? Probabilmente PassaFilm non è ancora installata.
          </p>
        </div>
        <h2 id="stores-title" data-i18n="storesTitle">Non hai ancora l'app?</h2>
        <p id="stores-body" data-i18n="storesBody">Installala, poi tocca di nuovo il link di invito.</p>
        <div class="stores__links">
          <a class="button button--tonal" id="app-store" href={appStoreUrl}>App Store</a>
          <a class="button button--tonal" id="play-store" href={playStoreUrl}>Google Play</a>
        </div>
      </section>
    </main>

    <script is:inline define:vars={{ playStoreUrl }}>
      const strings = {
        it: {
          title: "Ti hanno invitato in un gruppo",
          lede: "Consigliatevi film tra amici e tenete traccia di cosa guardare.",
          codeLabel: "Codice invito",
          open: "Apri in PassaFilm",
          copy: "Copia codice",
          copied: "Copiato",
          invalidTitle: "Questo link di invito è incompleto",
          invalidBody: "Chiedi a chi ti ha invitato di mandartelo di nuovo, oppure fatti dire il codice.",
          storesTitle: "Non hai ancora l'app?",
          storesBody: "Installala, poi tocca di nuovo il link di invito.",
          storesBodyDesktop: "Installala sul telefono, poi apri lì il link di invito.",
          notInstalled: "Non si è aperto niente? Probabilmente PassaFilm non è ancora installata.",
        },
        en: {
          title: "You've been invited to a group",
          lede: "Recommend movies to your friends and keep track of what to watch.",
          codeLabel: "Invite code",
          open: "Open in PassaFilm",
          copy: "Copy code",
          copied: "Copied",
          invalidTitle: "This invite link is incomplete",
          invalidBody: "Ask the person who invited you to send it again, or to tell you the code.",
          storesTitle: "Don't have the app yet?",
          storesBody: "Install it, then tap the invite link again.",
          storesBodyDesktop: "Install it on your phone, then open the invite link there.",
          notInstalled: "Nothing happened? PassaFilm probably isn't installed yet.",
        },
      };

      const locale = (navigator.language || "it").toLowerCase().startsWith("it") ? "it" : "en";
      const t = strings[locale];
      document.documentElement.lang = locale;
      document.title = locale === "it" ? "Unisciti al mio gruppo su PassaFilm" : "Join my group on PassaFilm";
      document.querySelectorAll("[data-i18n]").forEach((el) => {
        el.textContent = t[el.dataset.i18n];
      });

      // Same alphabet as the codes generated by the database: no 0/O or 1/I
      const raw = new URLSearchParams(location.search).get("code") || "";
      const code = raw.trim().toUpperCase();
      const isValid = /^[A-HJ-NP-Z2-9]{6}$/.test(code);

      // iPadOS reports itself as a Mac, so tell it apart by touch support
      const isAndroid = /android/i.test(navigator.userAgent);
      const isIOS =
        /iPhone|iPad|iPod/i.test(navigator.userAgent) ||
        (/Macintosh/i.test(navigator.userAgent) && navigator.maxTouchPoints > 1);
      const isMobile = isAndroid || isIOS;

      // Lead with the store for this device; on desktop there's no app to open, so point at the phone instead
      if (isIOS) document.getElementById("play-store").hidden = true;
      if (isAndroid) document.getElementById("app-store").hidden = true;
      if (!isMobile) document.getElementById("stores-body").textContent = t.storesBodyDesktop;

      document.getElementById(isValid ? "ticket" : "invalid").hidden = false;

      if (isValid) {
        document.getElementById("code").textContent = code;

        const openLink = document.getElementById("open");
        const appPath = "groups/join?code=" + encodeURIComponent(code);
        // Chrome on Android only follows custom schemes through an intent, which also falls back to the Play Store
        openLink.href = isAndroid
          ? "intent://" +
            appPath +
            "#Intent;scheme=passafilm;package=com.passafilm.app;S.browser_fallback_url=" +
            encodeURIComponent(playStoreUrl) +
            ";end"
          : "passafilm://" + appPath;
        openLink.hidden = !isMobile;

        // iOS has no intent fallback: without the app Safari just shows an "invalid address" alert. If the page is
        // still in front shortly after, point at the App Store instead of redirecting, since with the app installed
        // Safari first asks "Open in PassaFilm?" and the page stays visible while the visitor reads that prompt.
        if (isIOS) {
          let fallbackTimer;
          const cancelFallback = () => clearTimeout(fallbackTimer);
          document.addEventListener("visibilitychange", () => document.hidden && cancelFallback());
          window.addEventListener("pagehide", cancelFallback);

          openLink.addEventListener("click", () => {
            cancelFallback();
            fallbackTimer = setTimeout(() => {
              if (document.visibilityState !== "visible") return;
              document.getElementById("not-installed").hidden = false;
              document.getElementById("app-store").classList.replace("button--tonal", "button--primary");
              const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
              document.getElementById("stores").scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth" });
            }, 2000);
          });
        }

        const copyButton = document.getElementById("copy");
        const copyLabel = document.getElementById("copy-label");
        const copyIcon = document.getElementById("copy-icon");
        const copyPath = copyIcon.getAttribute("d");
        const checkPath =
          "M229.66 77.66l-128 128a8 8 0 0 1-11.32 0l-56-56a8 8 0 0 1 11.32-11.32L96 188.69 218.34 66.34a8 8 0 0 1 11.32 11.32Z";
        let resetTimer;

        copyButton.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(code);
          } catch {
            const range = document.createRange();
            range.selectNodeContents(document.getElementById("code"));
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
            return;
          }
          copyLabel.textContent = t.copied;
          copyIcon.setAttribute("d", checkPath);
          clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            copyLabel.textContent = t.copy;
            copyIcon.setAttribute("d", copyPath);
          }, 2000);
        });
      }
    </script>
  </body>
</html>

---
import LinkPageScript from "../../components/passafilm/LinkPageScript.astro";
import LinkPageStyles from "../../components/passafilm/LinkPageStyles.astro";

// Landing for PassaFilm personal links ("send me movies"). With the app installed, iOS universal links and Android
// app links open the app directly and this page is never shown; it covers everyone else. Unlike a group invite the
// code can't be typed into the app, so the page only offers to open the link there.
const appStoreId = "6836820722";
const appStoreUrl = `https://apps.apple.com/app/id${appStoreId}`;
const playStoreUrl = "https://play.google.com/store/apps/details?id=com.passafilm.app";
const title = "Mandami i film che pensi debba vedere";
const description = "Su PassaFilm ci si consigliano film in privato: solo film, nessun messaggio.";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0b0b14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/passafilm/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/passafilm/Outfit-VF.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PassaFilm" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://bertolotti.dev/passafilm/og.png" />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta name="twitter:card" content="summary" />
    <!-- Safari's Smart App Banner, filled in before Safari reads the tag. Only the encoded code is taken from the URL,
         so a crafted link can't slip extra comma-separated keys into it. -->
    <meta name="apple-itunes-app" id="itunes" content={`app-id=${appStoreId}`} />
    <script is:inline define:vars={{ appStoreId }}>
      const personalCode = new URLSearchParams(location.search).get("code");
      if (personalCode) {
        const appArgument = "https://bertolotti.dev/passafilm/u?code=" + encodeURIComponent(personalCode.trim());
        document.getElementById("itunes").content = "app-id=" + appStoreId + ", app-argument=" + appArgument;
      }
    </script>
    <LinkPageStyles />
  </head>
  <body>
    <main>
      <img class="logo" src="/passafilm/logo.svg" alt="PassaFilm" width="732" height="156" />

      <h1 data-i18n="title">Mandami i film che pensi debba vedere</h1>
      <p class="lede" data-i18n="lede">{description}</p>

      <section class="ticket" id="ticket" hidden>
        <div class="ticket__actions">
          <a class="button button--primary" id="open" href="#" data-i18n="open">Apri in PassaFilm</a>
        </div>
      </section>

      <section class="invalid" id="invalid" hidden>
        <strong data-i18n="invalidTitle">Questo link è incompleto</strong>
        <span data-i18n="invalidBody">Chiedi a chi te l'ha mandato di condividerlo di nuovo.</span>
      </section>

      <section class="stores" id="stores" aria-labelledby="stores-title">
        <!-- The live region stays in the DOM so screen readers announce the notice when it's revealed -->
        <div role="status">
          <p class="notice" id="not-installed" hidden data-i18n="notInstalled">
            Non si è aperto niente? Probabilmente PassaFilm non è ancora installata.
          </p>
        </div>
        <h2 id="stores-title" data-i18n="storesTitle">Non hai ancora l'app?</h2>
        <p id="stores-body" data-i18n="storesBody">Installala, poi tocca di nuovo questo link.</p>
        <div class="stores__links">
          <a class="button button--tonal" id="app-store" href={appStoreUrl}>App Store</a>
          <a class="button button--tonal" id="play-store" href={playStoreUrl}>Google Play</a>
        </div>
      </section>
    </main>

    <LinkPageScript />
    <script is:inline define:vars={{ playStoreUrl }}>
      const strings = {
        it: {
          title: "Mandami i film che pensi debba vedere",
          lede: "Su PassaFilm ci si consigliano film in privato: solo film, nessun messaggio.",
          open: "Apri in PassaFilm",
          invalidTitle: "Questo link è incompleto",
          invalidBody: "Chiedi a chi te l'ha mandato di condividerlo di nuovo.",
          storesTitle: "Non hai ancora l'app?",
          storesBody: "Installala, poi tocca di nuovo questo link.",
          storesBodyDesktop: "Installala sul telefono, poi apri lì questo link.",
          notInstalled: "Non si è aperto niente? Probabilmente PassaFilm non è ancora installata.",
        },
        en: {
          title: "Send me the movies you think I should watch",
          lede: "On PassaFilm you recommend movies to each other privately: just movies, no messages.",
          open: "Open in PassaFilm",
          invalidTitle: "This link is incomplete",
          invalidBody: "Ask the person who sent it to share it again.",
          storesTitle: "Don't have the app yet?",
          storesBody: "Install it, then tap this link again.",
          storesBodyDesktop: "Install it on your phone, then open this link there.",
          notInstalled: "Nothing happened? PassaFilm probably isn't installed yet.",
        },
      };

      const link = window.passafilmLink;
      const { t } = link.translate(strings);
      document.title = t.title;

      const code = link.readCode();
      link.showStores(t.storesBodyDesktop);
      document.getElementById("invalid").hidden = !!code;

      // On desktop there's nothing to open: only the stores are shown
      if (code && link.isMobile) {
        document.getElementById("ticket").hidden = false;
        const openLink = document.getElementById("open");
        openLink.href = link.openInAppHref("groups/connect?code=" + encodeURIComponent(code), playStoreUrl);
        link.pointAtAppStoreIfNothingOpens(openLink);
      }
    </script>
  </body>
</html>
